# Plantilla para DESARROLLO LOCAL con Docker Compose.
# Uso: cp .env.example .env  y después  docker compose up --build
# Con estos valores el stack arranca sin cambiar nada.
# En un VPS NO uses estos valores: usa .env.production.example y genera tu propia clave.

# SOLO DESARROLLO LOCAL: clave de ejemplo (mínimo 32 caracteres). No es un secreto.
JWT_SECRET_KEY=dev-only-local-key-not-for-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Opcional: correo de recuperación de contraseña (Resend). Vacío = no se envían correos.
RESEND_API_KEY=
EMAIL_FROM=brasaland@example.invalid
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_EXPIRE_MINUTES=30

# Opcional: base de datos del inventario. Vacío = el inventario no estará disponible.
DATABASE_URL=

# Orígenes permitidos por la API (sin barra final): website (3000) y backoffice (3001).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Puertos publicados en tu máquina.
BACKOFFICE_PORT=3001
WEBSITE_PORT=3000

# Activa polling para detectar cambios en bind mounts.
WATCH_POLLING=true

# URL pública de la API para el navegador.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Hosts de Vite separados por comas; usa * solo en desarrollo.
VITE_ALLOWED_HOSTS=

# URL interna de la API para llamadas server-side dentro de la red Docker.
API_INTERNAL_URL=http://api:8000
