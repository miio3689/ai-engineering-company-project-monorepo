# Copia esta plantilla a .env en la raíz y reemplaza los valores de relleno.
# Genera una clave segura con:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_GENERADA

# Duración del token de acceso en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Resend: configura una clave válida en tu entorno local o gestor de secretos.
RESEND_API_KEY=REEMPLAZAR_CON_CLAVE_DE_RESEND
EMAIL_FROM=brasaland@example.invalid
FRONTEND_BASE_URL=https://frontend.example.invalid
PASSWORD_RESET_EXPIRE_MINUTES=30

# URL deliberadamente ficticia; reemplázala por la conexión de tu base de datos.
DATABASE_URL=postgresql://usuario:CAMBIAR@db.example.invalid:5432/brasaland

# Orígenes permitidos, separados por comas. Sustituye el ejemplo al configurar
# el frontend; no se incluyen aquí dominios reales.
CORS_ALLOWED_ORIGINS=https://frontend.example.invalid

# Puertos publicados para las interfaces.
BACKOFFICE_PORT=3000
WEBSITE_PORT=5174

# Activa polling para detectar cambios en bind mounts.
WATCH_POLLING=true

# URL pública del API para el navegador.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Hosts de Vite separados por comas; usa * solo en desarrollo.
VITE_ALLOWED_HOSTS=
